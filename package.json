{
  "name": "adforge",
  "private": true,
  "packageManager": "pnpm@12.11.2",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "boot-check": "pnpm --filter @adforge/core boot-check",
    "db:generate": "pnpm --filter @adforge/db generate",
    "db:seed": "pnpm --filter @adforge/db seed",
    "seed:brand": "pnpm --filter @adforge/db seed:brand",
    "db:migrate": "pnpm --filter @adforge/db db:migrate",
    "db:check": "pnpm --filter @adforge/db db:check",
    "smoke:comfy": "pnpm --filter @adforge/provider-comfyui smoke",
    "e2e:render": "pnpm --filter @adforge/renderer-hyperframes e2e",
    "e2e:shortlist": "pnpm --filter @adforge/db e2e:shortlist",
    "e2e:voice": "pnpm --filter @adforge/provider-voice-service e2e",
    "e2e:voice-ab": "pnpm --filter @adforge/provider-voice-service e2e:ab",
    "e2e:llm": "pnpm --filter @adforge/provider-claude-agent-sdk e2e",
    "e2e:pipeline": "pnpm --filter @adforge/worker e2e",
    "e2e:library": "pnpm --filter @adforge/worker e2e:library",
    "e2e:r2": "pnpm --filter @adforge/worker e2e:r2",
    "e2e:edit": "pnpm --filter @adforge/worker e2e:edit",
    "e2e:ui": "pnpm --filter @adforge/web e2e"
  },
  "devDependencies": {
    "turbo": "catalog:",
    "typescript": "catalog:",
    "@types/node": "catalog:"
  }
}
