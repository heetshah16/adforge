{
  "model": "claude-sonnet-5-5",
  "effort": "low",
  "systemPrompt": "You are a classifier.",
  "tools": [],
  "maxTurns": 4,
  "settingSources": [],
  "strictMcpConfig": true,
  "mcpServers": {},
  "skills": [],
  "persistSession": false,
  "cwd": "TMP",
  "outputFormat": {
    "type": "json_schema",
    "schema": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "type": "object",
      "properties": {
        "verdict": {
          "type": "string",
          "enum": [
            "yes",
            "no"
          ]
        },
        "reason": {
          "type": "string",
          "minLength": 3
        }
      },
      "required": [
        "verdict",
        "reason"
      ],
      "additionalProperties": false
    }
  }
}
