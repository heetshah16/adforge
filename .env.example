# Copy to .env. Empty values mean "use the default".

# Keep data OUTSIDE OneDrive — sync locks PGlite and media files.
ADFORGE_DATA_DIR=C:/adforge-data
ADFORGE_WORKER_PORT=3001
# Media is served by the worker.
ADFORGE_PUBLIC_URL=http://127.0.0.1:3001
# Exact origin of the review UI (CORS + CSRF check); 127.0.0.1:3000 != localhost:3000.
ADFORGE_UI_ORIGIN=http://localhost:3000

# Provider ids (must be registered)
ADFORGE_PROVIDER_STORAGE=local
ADFORGE_PROVIDER_IMAGE=comfyui
ADFORGE_PROVIDER_CUTOUT=comfyui
ADFORGE_PROVIDER_VIDEO=comfyui

# ComfyUI
COMFYUI_URL=http://127.0.0.1:8188
ADFORGE_COMFY_WORKFLOW_PLATE=plate-flux-schnell
ADFORGE_COMFY_WORKFLOW_BROLL=broll-wan22-5b
ADFORGE_COMFY_WORKFLOW_CUTOUT=cutout-birefnet

# Voice (Chatterbox + Whisper service, scripts/voice.ps1)
ADFORGE_PROVIDER_TTS=chatterbox
ADFORGE_PROVIDER_ALIGNER=whisper
ADFORGE_VOICE_URL=http://127.0.0.1:8190
# Only needed when a language routes to qwen (engineByLanguage)
ADFORGE_QWEN_TTS_URL=http://127.0.0.1:8191

# Vision (depth + OCR + luma service, scripts/vision.ps1)
ADFORGE_VISION_URL=http://127.0.0.1:8192

# LLM via Claude Agent SDK on your Claude subscription (local POC only — ADR 0009).
ADFORGE_PROVIDER_LLM=claude-agent-sdk
ADFORGE_LLM_STRATEGIST=claude-sonnet-5-5
ADFORGE_LLM_DIRECTOR=claude-opus-5-5
ADFORGE_LLM_EFFORT_STRATEGIST=medium
ADFORGE_LLM_EFFORT_DIRECTOR=high
ADFORGE_LLM_VISION=claude-sonnet-5-5
ADFORGE_LLM_EFFORT_VISION=low

# Full path to ffmpeg.exe if not on PATH
# HYPERFRAMES_FFMPEG_PATH=

# Postgres (Supabase dev session pooler :5432). Set = Postgres in any profile; empty = local PGlite (dev).
DATABASE_URL=

# Web server (apps/web/.env.local)
# dev (default): anyone may sign in and get an account. prod: only invited users and admins.
# ADFORGE_ENV=dev
# Magic-link and sign-out origin; the only source of emailRedirectTo. Defaults to http://localhost:3000 in dev, required in prod.
# ADFORGE_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
# Comma list
ADFORGE_ADMIN_EMAILS=
INNGEST_EVENT_KEY=
INNGEST_DEV=
